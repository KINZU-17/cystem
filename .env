# ── Supabase (game engine multiplayer) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=cystem_user
POSTGRES_PASSWORD=cystem_secure_pass
# Local development database (Docker compose overrides this with PostgreSQL):
DATABASE_URL=sqlite:///./cystem.db

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# ── M-Pesa Daraja API ────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_daraja_passkey
MPESA_CALLBACK_URL=https://your-domain.com/mpesa/callback
MPESA_SANDBOX=true

# ── Game engine ──────────────────────────────────────────────────────────────
APPROVED_PLAY_AREA=false
