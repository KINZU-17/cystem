# CYSTEM Master Environment Configuration

# Application
PROJECT_NAME="CYSTEM Engine"
ENVIRONMENT="development"
DEBUG=True
PORT=8000

# Database
# Use SQLite for zero-setup local dev, or PostgreSQL for production:
DATABASE_URL=sqlite:///./cystem.db
# DATABASE_URL=postgresql://cystem_user:cystem_secure_pass@localhost:5432/cystem_db

# Security & JWT Auth
JWT_SECRET_KEY=cystem_ultra_secure_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# M-Pesa Safaricom Daraja API (Sandbox Defaults)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://cystem.ngrok-free.app/api/v1/wallet/mpesa/callback

# M-Pesa B2C Payouts (Withdrawals)
MPESA_B2C_SHORTCODE=600000
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_CERT_PATH=./server/certs/sandbox_cert.cer

# Financial Logic
POINTS_TO_KSH_RATE=130.0
ADMIN_WITHDRAWAL_FEE_KSH=3.0

# SMS Gateway (Africa's Talking)
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key

# Admin & Dispute Access Key
ADMIN_SECRET_KEY=cystem_admin_super_secret_override_2026
